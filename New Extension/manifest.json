{
  "manifest_version": 3,
  "name": "Quality Review",
  "version": "1.0.0",
  "description": "Review test cases against a user story and its acceptance criteria.",
  "permissions": ["storage"],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "options_page": "src/options/options.html"
}
